# Regenerate with: vhs demo.tape   (point GH_YAP_REPO at your own sandbox)
Output assets/tui.gif
Set Shell "bash"
Set FontSize 16
Set Width 1100
Set Height 680
Set Padding 10
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set BorderRadius 10
Env GH_YAP_REPO "josemingorance/yap-demo"
Env GH_YAP_LANG "en"
Type "gh yap tui" Sleep 300ms Enter Sleep 4s
Down Sleep 600ms Down Sleep 800ms
Enter Sleep 3s
Escape Sleep 800ms
Type "2" Sleep 1.5s
Enter Sleep 1.5s
Type "2" Sleep 2.5s
Escape Sleep 600ms
Type "4" Sleep 2s
Type "1" Sleep 600ms
Type "p" Sleep 800ms
Type "hello from the full-screen tui 🖥️" Sleep 2s
Escape Sleep 1s
Type "q" Sleep 500ms
